<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Pour lister toutes les applis installées (lanceur). -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- Pour ouvrir le volet de notifications / réglages rapides. -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <!-- Bannière « nom du contact » par-dessus les autres applis (SMS / appels). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Composeur LexOS : appeler directement. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- Verrouillage : météo (Open-Meteo, sans compte) et prochains événements de l'agenda. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <application
        android:name=".LexOSApp"
        android:label="LexOS PRO"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/LexOS"
        android:hardwareAccelerated="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:clearTaskOnLaunch="true"
            android:stateNotNeeded="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Écran de verrouillage LexOS (par-dessus le verrouillage Samsung). -->
        <activity
            android:name=".VerrouActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="ca.lexos.lanceur.verrou"
            android:screenOrientation="portrait"
            android:noHistory="false"
            android:theme="@style/LexOS" />

        <!-- Écoute des notifications SMS / appels pour animer le nom du contact. -->
        <service
            android:name=".NotifService"
            android:label="LexOS PRO — noms animés"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Émojis LexOS partagés comme images par le clavier. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.emojis"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/fichiers" />
        </provider>

        <!-- Clavier LexOS PRO. -->
        <service
            android:name=".ClavierService"
            android:label="Clavier LexOS PRO"
            android:exported="true"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/clavier" />
        </service>
    </application>
</manifest>
